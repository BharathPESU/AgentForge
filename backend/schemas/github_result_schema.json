{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentForgeGitHubResult",
  "description": "Schema for GitHub Agent execution output and handoff contract for Deployer Agent",
  "type": "object",
  "required": [
    "status",
    "project_path"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "failed", "blocked"],
      "description": "Overall status of GitHub publishing"
    },
    "project_path": {
      "type": "string",
      "description": "Path to the generated project directory"
    },
    "repository": {
      "type": "object",
      "required": ["owner", "name", "url", "branch", "private"],
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "branch": { "type": "string" },
        "private": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "required": ["sha", "message"],
      "properties": {
        "sha": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "description": "Reason code if status is failed or blocked"
    },
    "error_category": {
      "type": "string",
      "description": "Classification of failure if applicable"
    },
    "message": {
      "type": "string",
      "description": "Human readable detail or error message"
    },
    "next_action": {
      "type": "object",
      "required": ["agent", "reason"],
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["deployer_agent", "tester_agent", "coder_agent", "github_agent"]
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
