{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentForgeCoderResult",
  "description": "Schema for Coder Agent execution output and handoff contract",
  "type": "object",
  "required": [
    "status",
    "project_path",
    "ready_for_testing"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "failed"]
    },
    "project_path": {
      "type": "string",
      "description": "Path to the generated project directory"
    },
    "template_used": {
      "type": "boolean",
      "description": "Whether the backend template was copied/used"
    },
    "agents_updated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of agents updated or created"
    },
    "files_created": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of newly created files"
    },
    "files_modified": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of modified files"
    },
    "ready_for_testing": {
      "type": "boolean",
      "description": "True if code is ready for handoff to Tester Agent"
    },
    "reason": {
      "type": "string",
      "description": "Reason for failure if status is failed"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional error details or context"
    }
  }
}
