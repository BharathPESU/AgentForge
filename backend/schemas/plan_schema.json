{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentForgeArchitecturePlan",
  "description": "Schema for AgentForge Architecture Plan generated by Architect Agent",
  "type": "object",
  "required": [
    "project",
    "assumptions",
    "agents",
    "wiring"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "description",
        "goal"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Machine-readable name of the project"
        },
        "description": {
          "type": "string",
          "description": "Short description of the project"
        },
        "goal": {
          "type": "string",
          "description": "High-level goal of the system"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "description": "List of assumptions made while architecting the system",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "description": "List of specialized agents in the architecture",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "responsibility",
          "input",
          "output",
          "is_root",
          "tools_required"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^agent[0-9]+$",
            "description": "Stable machine-readable identifier (e.g., agent1, agent2)"
          },
          "name": {
            "type": "string",
            "description": "Descriptive human-readable agent name"
          },
          "description": {
            "type": "string",
            "description": "Brief description of the agent"
          },
          "responsibility": {
            "type": "string",
            "description": "Detailed responsibility of the agent"
          },
          "input": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Expected input fields or objects"
          },
          "output": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Expected output fields or objects"
          },
          "is_root": {
            "type": "boolean",
            "description": "True if this agent is the root orchestrator"
          },
          "tools_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "High-level tools or capabilities required by this agent"
          }
        }
      }
    },
    "wiring": {
      "type": "array",
      "description": "Communication wiring between agents",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "condition",
          "input",
          "output",
          "execution"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "description": "ID of the source agent"
          },
          "to": {
            "type": "string",
            "description": "ID of the target agent"
          },
          "condition": {
            "type": "string",
            "description": "Condition under which this invocation occurs (e.g. 'always', 'papers_found')"
          },
          "input": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Input parameters passed from source to target agent"
          },
          "output": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output parameters returned from target to source agent"
          },
          "execution": {
            "type": "string",
            "enum": [
              "sequential",
              "parallel"
            ],
            "description": "Execution pattern: sequential or parallel"
          }
        }
      }
    }
  }
}
