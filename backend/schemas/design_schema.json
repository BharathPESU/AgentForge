{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentForgeDetailedDesign",
  "description": "Schema for detailed implementation design generated by Designer Agent",
  "type": "object",
  "required": [
    "project",
    "agents",
    "wiring"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Machine-readable name of the project"
        },
        "description": {
          "type": "string",
          "description": "Short description of the project"
        }
      }
    },
    "agents": {
      "type": "array",
      "description": "List of detailed agent designs",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "responsibility",
          "model",
          "system_prompt",
          "inputs",
          "outputs",
          "tools",
          "constraints",
          "error_handling",
          "handoff"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^agent[0-9]+$",
            "description": "Stable machine-readable identifier (e.g., agent1, agent2)"
          },
          "name": {
            "type": "string",
            "description": "Descriptive human-readable agent name"
          },
          "description": {
            "type": "string",
            "description": "Brief description of the agent"
          },
          "responsibility": {
            "type": "string",
            "description": "Detailed responsibility of the agent"
          },
          "model": {
            "type": "object",
            "required": [
              "provider",
              "model_name",
              "temperature"
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "description": "Model provider (e.g. google)"
              },
              "model_name": {
                "type": "string",
                "description": "Model name (e.g. gemini-2.5-flash)"
              },
              "temperature": {
                "type": "number",
                "description": "Sampling temperature"
              },
              "reason": {
                "type": "string",
                "description": "Reason for model selection"
              }
            }
          },
          "system_prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Complete implementation-ready system instruction prompt"
          },
          "inputs": {
            "type": "array",
            "description": "Input parameters expected by the agent",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "description",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "description": "Output parameters produced by the agent",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Detailed specifications for tools required by this agent",
            "items": {
              "type": "object",
              "required": [
                "name",
                "description",
                "purpose",
                "inputs",
                "outputs",
                "when_to_use",
                "restrictions"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type",
                      "description"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type",
                      "description"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                },
                "when_to_use": {
                  "type": "string"
                },
                "restrictions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Safety and behavioral constraints"
          },
          "error_handling": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Error handling strategies"
          },
          "handoff": {
            "type": "object",
            "required": [
              "upstream",
              "downstream"
            ],
            "additionalProperties": false,
            "properties": {
              "upstream": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of upstream agents"
              },
              "downstream": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of downstream agents"
              }
            }
          }
        }
      }
    },
    "wiring": {
      "type": "array",
      "description": "Communication wiring preserved from plan.json",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "condition",
          "input",
          "output",
          "execution"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "input": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution": {
            "type": "string",
            "enum": [
              "sequential",
              "parallel"
            ]
          }
        }
      }
    }
  }
}
